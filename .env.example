# Copy to .env to override defaults. .env is git-ignored.

# Host ports (change if they clash with something on your machine)
PG_HOST_PORT=15432
MONGO_HOST_PORT=37017
API_HOST_PORT=4000
WEB_HOST_PORT=5173
ADMINER_HOST_PORT=8080
MONGO_EXPRESS_HOST_PORT=8081

# Seed sizes (smaller numbers seed faster)
SEED_USERS=10000
SEED_RESTAURANTS=500
SEED_ORDERS=120000
SEED_PINGS=500000

# Set to true if the web app doesn't reload when you save a file
# (common on Windows when the repo is outside WSL)
WEB_POLLING=false
