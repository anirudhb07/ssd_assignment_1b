  {
   "id": "91dhodzdoc9is0j8",
   "type": "text",
   "x": 0,
   "y": 62,
   "width": 1064.88,
   "height": 170.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
